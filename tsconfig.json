{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "checkJs": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["vitest.config.js", "eslint.config.js"],
  "exclude": ["node_modules", "src"]
}