+# ==== Base de données (inchangé) ====
+DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-x-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
+DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-x-eu-west-3.pooler.supabase.com:5432/postgres"
+
+PORT=4000
+JWT_SECRET=...
+
+# Domaines autorisés à appeler l'API, séparés par des virgules (mets tes
+# vraies URLs Vercel une fois déployé). Laisser vide = ouvert à tous
+# (pratique en local, à éviter en production).
+CORS_ORIGINS=
+
+# ==== Supabase Storage (inchangé) ====
+SUPABASE_URL=https://xxxx.supabase.co
+SUPABASE_SERVICE_KEY=...
+
+# ==== FedaPay ====
+# Dashboard FedaPay > Paramètres > Clés API. Utilise les clés "sandbox"
+# tant que tu testes, puis bascule sur les clés "live" + FEDAPAY_ENV=live
+# le jour où tu es prêt à encaisser du vrai argent.
+FEDAPAY_ENV=sandbox
+FEDAPAY_PUBLIC_KEY=pk_sandbox_...
+FEDAPAY_SECRET_KEY=sk_sandbox_...
+# Dashboard FedaPay > Webhooks > (ton endpoint) > "Cliquer pour révéler".
+# Différent entre sandbox et live, et par endpoint configuré.
+FEDAPAY_WEBHOOK_SECRET=wh_sandbox_...
+
+# URL publique de SHOPIKA_clients, utilisée pour rediriger le client après
+# son paiement FedaPay (ex: https://app.shopika.com — sans slash final).
+CLIENT_APP_URL=http://localhost:5500
+
+# URL publique de SHOPIKA_marchand, utilisée pour rediriger le marchand
+# après un paiement d'abonnement (création boutique / réabonnement).
