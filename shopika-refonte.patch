+/* Pages de contenu (aide, conditions, confidentialité) et 404 */
+.doc-main { max-width: 760px; margin: 0 auto; padding: 48px 22px 80px; }
+.doc-title { font-family: var(--font-display); font-size: clamp(28px, 4vw, 40px); font-weight: 800; letter-spacing: -.02em; }
+.doc-intro { color: var(--color-gray); margin: 8px 0 28px; font-size: 16px; }
+.doc-body h2 { font-size: 18px; margin: 28px 0 8px; font-family: var(--font-display); }
+.doc-body p { line-height: 1.7; color: var(--color-text-soft, #3a3d4d); margin-bottom: 10px; }
+.doc-body a, .doc-note a { color: var(--color-pink); font-weight: 600; }
+.doc-note { margin-top: 28px; font-size: 13.5px; color: var(--color-gray); }
+.faq { display: grid; gap: 10px; }
+.faq-item { border: 1px solid var(--color-line); border-radius: 14px; background: var(--color-bg); overflow: hidden; transition: box-shadow .2s ease; }
+.faq-item[open] { box-shadow: var(--shadow-md); }
+.faq-item summary { cursor: pointer; list-style: none; padding: 16px 48px 16px 18px; font-weight: 600; position: relative; }
+.faq-item summary::-webkit-details-marker { display: none; }
+.faq-item summary::after { content: "+"; position: absolute; right: 18px; top: 50%; transform: translateY(-50%); font-size: 22px; font-weight: 400; color: var(--color-pink); transition: transform .25s ease; }
+.faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
+.faq-body { padding: 0 18px 16px; color: var(--color-text-soft, #3a3d4d); line-height: 1.7; }
+@media (prefers-reduced-motion: no-preference) { .faq-item[open] .faq-body { animation: mt-fade-in .3s ease both; } }
+.nf { min-height: 100vh; display: grid; place-content: center; text-align: center; padding: 24px; gap: 8px; }
+.nf-code { font-family: var(--font-display); font-size: clamp(72px, 16vw, 140px); font-weight: 800; line-height: 1; background: var(--brand-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
+.nf h1 { font-size: 24px; } .nf p { color: var(--color-gray); }
+.nf-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 14px; }
+.nf-btn { background: var(--brand-gradient); color: #fff; padding: 12px 22px; border-radius: 999px; font-weight: 600; }
+.nf-btn.ghost { background: transparent; color: var(--color-text); border: 1.5px solid var(--color-line); }
