+// Courbe SVG sans dépendance. `data` : [{ date: 'YYYY-MM-DD', amount, orders }]
+export default function AreaChart({ data, height = 220 }) {
+  const W = 720, H = height, padL = 46, padR = 14, padT = 14, padB = 28;
+  const innerW = W - padL - padR, innerH = H - padT - padB;
+  const max = Math.max(...data.map((d) => d.amount), 1);
+  const step = data.length > 1 ? innerW / (data.length - 1) : 0;
+  const pts = data.map((d, i) => ({ x: padL + step * i, y: padT + innerH - (d.amount / max) * innerH, ...d }));
+  const line = pts.map((p, i) => `${i ? 'L' : 'M'}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
+  const area = `${line} L${pts[pts.length - 1].x.toFixed(1)} ${padT + innerH} L${pts[0].x.toFixed(1)} ${padT + innerH} Z`;
+  const ticks = [0, 0.5, 1];
+  const label = (d) => new Date(d + 'T00:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
+  const every = Math.ceil(data.length / 6);
+
+  return (
+    <svg viewBox={`0 0 ${W} ${H}`} className="w-full h-auto" role="img" aria-label="Volume des ventes sur 30 jours">
+      <defs>
+        <linearGradient id="admLine" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stopColor="#FA1757" /><stop offset="100%" stopColor="#FC7914" /></linearGradient>
+        <linearGradient id="admArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#FA1757" stopOpacity="0.2" /><stop offset="100%" stopColor="#FC7914" stopOpacity="0" /></linearGradient>
+      </defs>
+      {ticks.map((f) => {
+        const y = padT + innerH * f;
+        return (
+          <g key={f}>
+            <line x1={padL} x2={W - padR} y1={y} y2={y} stroke="#eceef3" />
+            <text x={padL - 8} y={y + 4} textAnchor="end" fontSize="11" fill="#9aa0b4">{Math.round((max * (1 - f)) / 1000)}k</text>
+          </g>
+        );
+      })}
+      <path d={area} fill="url(#admArea)" className="chart-fade" />
+      <path d={line} fill="none" stroke="url(#admLine)" strokeWidth="3" strokeLinecap="round" strokeLinejoin="round" pathLength="1" className="chart-draw" />
+      {pts.map((p, i) => (
+        <g key={p.date}>
+          {p.orders > 0 && <circle cx={p.x} cy={p.y} r="4" fill="#fff" stroke="#FA1757" strokeWidth="2.5"><title>{`${label(p.date)} : ${Math.round(p.amount).toLocaleString('fr-FR')} FCFA · ${p.orders} commande(s)`}</title></circle>}
+          {i % every === 0 && <text x={p.x} y={H - 8} textAnchor="middle" fontSize="11" fill="#9aa0b4">{label(p.date)}</text>}
+        </g>
+      ))}
+    </svg>
+  );
+}
diff --git a/apps/admin/src/components/CountUp.jsx b/apps/admin/src/components/CountUp.jsx
new file mode 100644
index 0000000..a3b4747
--- /dev/null
+++ b/apps/admin/src/components/CountUp.jsx
@@ -0,0 +1,25 @@
+import React, { useEffect, useRef, useState } from 'react';
+
+// Compteur animé (respecte prefers-reduced-motion). `format` : fonction d'affichage (ex. FCFA).
+export default function CountUp({ value, duration = 1000, format = (n) => Math.round(n).toLocaleString('fr-FR') }) {
+  const [shown, setShown] = useState(0);
+  const from = useRef(0);
+
+  useEffect(() => {
+    const target = Number(value) || 0;
+    const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+    if (reduce || from.current === target) { setShown(target); from.current = target; return undefined; }
+    const start = performance.now();
+    const origin = from.current;
+    let raf;
+    const tick = (now) => {
+      const p = Math.min((now - start) / duration, 1);
+      setShown(origin + (target - origin) * (1 - Math.pow(1 - p, 3)));
+      if (p < 1) raf = requestAnimationFrame(tick); else from.current = target;
+    };
+    raf = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(raf);
+  }, [value, duration]);
+
+  return <>{format(shown)}</>;
+}
diff --git a/apps/admin/src/components/Layout.jsx b/apps/admin/src/components/Layout.jsx
new file mode 100644
index 0000000..b947897
--- /dev/null
+++ b/apps/admin/src/components/Layout.jsx
@@ -0,0 +1,94 @@
+import React, { useEffect, useState } from 'react';
+import { Link, useLocation } from 'react-router-dom';
+import { LayoutDashboard, Store, DollarSign, AlertTriangle, MessageSquare, Settings, LogOut, ScrollText, Package, Users, Menu, X } from 'lucide-react';
+import { adminApi } from '../api';
+
+// `badge` : clé de /admin/overview affichée en pastille sur le menu (ce qui attend une action).
+const nav = [
+  { label: 'Tableau de bord', icon: LayoutDashboard, to: '/dashboard' },
+  { label: 'Commandes', icon: Package, to: '/orders' },
+  { label: 'Boutiques', icon: Store, to: '/stores' },
+  { label: 'Comptes', icon: Users, to: '/users' },
+  { label: 'Versements', icon: DollarSign, to: '/payouts', badge: ['pendingPayouts', 'pendingRefunds'] },
+  { label: 'Litiges', icon: AlertTriangle, to: '/disputes', badge: ['openDisputes'] },
+  { label: 'Support', icon: MessageSquare, to: '/support', badge: ['openSupport'] },
+  { label: "Journal d'audit", icon: ScrollText, to: '/audit' },
+  { label: 'Paramètres', icon: Settings, to: '/settings' },
+];
+
+export default function Layout({ children, onLogout }) {
+  const location = useLocation();
+  const [open, setOpen] = useState(false);
+  const [counts, setCounts] = useState(null);
+
+  // Le menu mobile se referme à chaque changement de page ; les pastilles se rafraîchissent aussi.
+  useEffect(() => {
+    setOpen(false);
+    adminApi.overview().then(setCounts).catch(() => {});
+  }, [location.pathname]);
+
+  const badgeFor = (item) => (item.badge && counts ? item.badge.reduce((s, k) => s + (counts[k] || 0), 0) : 0);
+
+  return (
+    <div className="flex min-h-screen">
+      {open && <div className="fixed inset-0 bg-black/50 z-30 md:hidden" onClick={() => setOpen(false)} aria-hidden="true" />}
+
+      {/* Sidebar : tiroir sur mobile, fixe dès md */}
+      <aside className={`w-64 bg-[#0D0D1A] text-white flex flex-col fixed top-0 left-0 h-full z-40 transition-transform duration-300 ease-out md:translate-x-0 ${open ? 'translate-x-0' : '-translate-x-full'}`}>
+        <div className="p-6 border-b border-white/10 flex items-center justify-between">
+          <div className="flex items-center gap-3">
+            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-[#FA1757] to-[#FC7914] flex items-center justify-center font-extrabold text-white text-lg">S</div>
+            <div>
+              <h1 className="font-extrabold text-lg leading-tight">Shopika</h1>
+              <p className="text-xs text-white/50">Espace Admin</p>
+            </div>
+          </div>
+          <button className="md:hidden text-white/70" onClick={() => setOpen(false)} aria-label="Fermer le menu"><X size={22} /></button>
+        </div>
+
+        <nav className="flex-1 p-4 space-y-1 overflow-y-auto">
+          {nav.map((item) => {
+            const active = location.pathname === item.to;
+            const Icon = item.icon;
+            const n = badgeFor(item);
+            return (
+              <Link
+                key={item.to}
+                to={item.to}
+                className={`flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all ${
+                  active ? 'bg-[#FA1757] text-white shadow-lg shadow-[#FA1757]/30' : 'text-white/70 hover:bg-white/5 hover:text-white hover:translate-x-0.5'
+                }`}
+              >
+                <Icon size={20} />
+                <span className="flex-1">{item.label}</span>
+                {n > 0 && <span className={`text-[11px] font-bold px-2 py-0.5 rounded-full ${active ? 'bg-white text-[#FA1757]' : 'bg-[#FA1757] text-white'}`}>{n > 99 ? '99+' : n}</span>}
+              </Link>
+            );
+          })}
+        </nav>
+
+        <div className="p-4 border-t border-white/10">
+          <button
+            onClick={onLogout}
+            className="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium text-white/70 hover:bg-white/5 hover:text-white w-full"
+          >
+            <LogOut size={20} />
+            Déconnexion
+          </button>
+        </div>
+      </aside>
+
+      {/* Main */}
+      <main className="flex-1 md:ml-64 min-w-0">
+        <header className="bg-white border-b border-gray-200 px-4 md:px-8 py-4 sticky top-0 z-20 flex items-center gap-3">
+          <button className="md:hidden text-[#0D0D1A]" onClick={() => setOpen(true)} aria-label="Ouvrir le menu"><Menu size={24} /></button>
+          <h2 className="text-xl font-bold text-[#0D0D1A]">Administration Shopika</h2>
+        </header>
+        {/* key = chemin : la transition rejoue à chaque page */}
+        <div key={location.pathname} className="p-4 md:p-8 page-enter">
+          {children}
+        </div>
+      </main>
+    </div>
+  );
+}
