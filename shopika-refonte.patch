+<link rel="stylesheet" href="css/motion.css">
+<link rel="stylesheet" href="css/auth.css">
+<script src="js/motion.js"></script>
+</head>
+<body>
+
+<main class="auth-page">
+  <div class="auth-card">
+    <div class="auth-logo">shop<span class="brandGradientText">ika</span></div>
+    <div id="resetForm">
+      <h1 class="auth-title">Choisissez un nouveau mot de passe</h1>
+      <p class="auth-subtitle">Au moins 6 caractères. Vos autres appareils seront déconnectés.</p>
+      <div id="errorBox" class="auth-error" style="display:none;"></div>
+      <form id="form" class="auth-form">
+        <div class="auth-field"><label for="pw1">Nouveau mot de passe</label><input id="pw1" type="password" minlength="6" autocomplete="new-password" required></div>
+        <div class="auth-field"><label for="pw2">Confirmez-le</label><input id="pw2" type="password" minlength="6" autocomplete="new-password" required></div>
+        <button id="submitBtn" class="auth-submit">Enregistrer</button>
+      </form>
+    </div>
+    <div id="doneBox" style="display:none;text-align:center;">
+      <svg class="mt-check" viewBox="0 0 72 72" aria-hidden="true"><circle cx="36" cy="36" r="30"/><path d="M22 37l10 10 18-20"/></svg>
+      <h1 class="auth-title" style="margin-top:12px;">Mot de passe modifié</h1>
+      <p class="auth-subtitle">Vous pouvez maintenant vous connecter.</p>
+      <a href="connexion.html" class="auth-submit" style="display:block;text-align:center;">Se connecter</a>
+    </div>
+    <div id="badLink" style="display:none;text-align:center;">
+      <h1 class="auth-title">Lien invalide</h1>
+      <p class="auth-subtitle">Ce lien est incomplet, a expiré ou a déjà servi.</p>
+      <a href="mot-de-passe-oublie.html" class="auth-submit" style="display:block;text-align:center;">Refaire une demande</a>
+    </div>
+  </div>
+</main>
+
+<script src="js/config.js"></script>
+<script src="js/api.js"></script>
+<script src="js/store.js"></script>
+<script src="js/i18n.js"></script>
+<script src="js/auth.js"></script>
+<script>
+document.documentElement.setAttribute("data-theme", localStorage.getItem("shopika_theme") || "light");
+const token = new URLSearchParams(location.search).get("token");
+if (!token) { document.getElementById("resetForm").style.display = "none"; document.getElementById("badLink").style.display = "block"; }
+document.getElementById("form").addEventListener("submit", async (e) => {
+  e.preventDefault();
+  const errorBox = document.getElementById("errorBox"), btn = document.getElementById("submitBtn");
+  const pw1 = document.getElementById("pw1").value, pw2 = document.getElementById("pw2").value;
+  errorBox.style.display = "none";
+  if (pw1 !== pw2) { errorBox.textContent = "Les deux mots de passe ne sont pas identiques."; errorBox.style.display = "block"; return; }
+  btn.disabled = true; btn.textContent = "Enregistrement…";
+  try {
+    await Api.apiFetch("/auth/reset-password", { method: "POST", auth: false, body: { token, password: pw1 } });
+    localStorage.removeItem("shopika_token"); localStorage.removeItem("shopika_user");
+    document.getElementById("resetForm").style.display = "none";
+    document.getElementById("doneBox").style.display = "block";
+  } catch (err) {
+    errorBox.textContent = err.message || "Impossible de modifier le mot de passe.";
+    errorBox.style.display = "block";
+    btn.disabled = false; btn.textContent = "Enregistrer";
+  }
+});
+</script>
+</body>
+</html>
