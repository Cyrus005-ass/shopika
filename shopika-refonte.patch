+  .track-step.done:nth-child(3)::before { animation-delay: .5s; }
+  .order-card { transition: transform .18s ease, box-shadow .18s ease; }
+  .order-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
+}
