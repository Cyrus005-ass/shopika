+            const data = await res.json();
+            items = data.notifications || []; unread = data.unreadCount || 0;
+            if (dot) dot.style.display = unread ? '' : 'none';
+            paint();
+        } catch (e) { /* hors ligne : on réessaiera */ }
+    }
