@@ -0,0 +1,49 @@
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
+
+* { box-sizing: border-box; }
+
+body { -webkit-font-smoothing: antialiased; }
+
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { background: #d9dbe6; border-radius: 8px; }
+
+.card {
+  @apply bg-white rounded-2xl border border-gray-100 shadow-sm;
+}
+
+.btn-primary {
+  @apply bg-brand-gradient text-white font-medium px-4 py-2.5 rounded-xl hover:opacity-90 transition disabled:opacity-50 disabled:cursor-not-allowed;
+}
+
+.btn-secondary {
+  @apply bg-gray-100 text-night font-medium px-4 py-2.5 rounded-xl hover:bg-gray-200 transition;
+}
+
+.input {
+  @apply w-full border border-gray-200 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-pink/40 focus:border-pink;
+}
+
+.badge {
+  @apply text-xs font-medium px-2 py-1 rounded-full;
+}
+
+/* ===== Animations ===== */
+@keyframes page-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
+@keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
+@keyframes shimmer { to { transform: translateX(100%); } }
+@keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
+@keyframes fade { from { opacity: 0; } to { opacity: 1; } }
+
+.skeleton { position: relative; overflow: hidden; background: #eceef3; }
+.skeleton::after { content: ''; position: absolute; inset: 0; transform: translateX(-100%); background: linear-gradient(90deg, transparent, rgba(255,255,255,.7), transparent); }
+.chart-draw { stroke-dasharray: 1; }
+
+@media (prefers-reduced-motion: no-preference) {
+  .page-enter { animation: page-in .35s cubic-bezier(.2,.7,.2,1); }
+  .stagger > * { animation: rise .55s cubic-bezier(.2,.7,.2,1) backwards; animation-delay: calc(var(--i, 0) * 60ms); }
+  .skeleton::after { animation: shimmer 1.4s ease-in-out infinite; }
+  .chart-draw { animation: draw 1.2s ease .2s backwards; }
+  .chart-fade { animation: fade 1s ease .5s backwards; }
+}
