{
  "name": "shopika",
  "private": true,
  "description": "Shopika — marketplace multi-boutiques (API + site client + espace marchand + admin). Chaque app est indépendante et déployée séparément.",
  "scripts": {
    "dev:all": "node scripts/dev-all.js",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:admin": "npm --prefix apps/admin run dev",
    "install:all": "npm --prefix apps/api install && npm --prefix apps/admin install",
    "sync:shared": "node scripts/sync-shared.js",
    "sync:shared:check": "node scripts/sync-shared.js --check",
    "lint": "npm --prefix apps/api run lint",
    "test": "npm --prefix apps/api test",
    "db:deploy": "npm --prefix apps/api run db:deploy",
    "check:migrations": "npm --prefix apps/api run check:migrations",
    "smoke": "npm --prefix apps/api run smoke"
  },
  "license": "ISC"
}
