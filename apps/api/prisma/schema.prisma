generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  marchand
  client
  admin
}

enum SubscriptionStatus {
  en_attente_paiement
  active
  suspendu
}

model User {
  id           Int      @id @default(autoincrement())

  // Le marchand se connecte par téléphone (unique s'il est renseigné).
  // Le client se connecte par e-mail (unique s'il est renseigné).
  // Les deux colonnes sont optionnelles car un compte n'a besoin que de
  // l'une des deux selon son rôle — voir routes/auth.routes.js pour le détail.
  phone        String?  @unique
  email        String?  @unique

  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  fullName     String   @map("full_name")

  address      String?
  city         String?
  country      String?

  role         Role     @default(client)
  passwordHash String?  @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")

  // Vérification par e-mail (comptes client). Les comptes marchand/admin
  // créés par téléphone n'utilisent pas ce mécanisme.
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationCode    String?   @map("email_verification_code")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  emailVerificationSentAt  DateTime? @map("email_verification_sent_at")
  // Essais ratés sur le code à 6 chiffres : au-delà de 5, le code est invalidé.
  emailVerificationAttempts Int      @default(0) @map("email_verification_attempts")

  // Verrouillage anti force-brute du mot de passe (8 échecs -> 15 min).
  // Stocké en base (et non en mémoire) car l'API tourne en serverless :
  // chaque instance aurait sinon son propre compteur.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  twoFactorOn  Boolean  @default(false) @map("two_factor_on")

  // Notifications par e-mail (commandes payées, stock bas sur ses
  // produits). Le marchand renseigne son adresse dans l'espace
  // marchand (PATCH /api/auth/me) et peut désactiver ici.
  emailNotifications Boolean  @default(true) @map("email_notifications")

  createdAt    DateTime @default(now()) @map("created_at")
  stores       Store[]
  orders       Order[]
  notifications Notification[]
  supportMessages SupportMessage[]
  favorites    Favorite[]
  auditLogs    AdminAuditLog[]
  tokenVersion Int @default(0) @map("token_version")

  @@map("users")
}

model Store {
  id             Int      @id @default(autoincrement())
  merchantId     Int      @unique @map("merchant_id")
  merchant       User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name           String
  subdomain      String   @unique
  customDomain   String?  @unique @map("custom_domain")
  themeId        Int      @default(1) @map("theme_id")
  logoUrl        String?  @map("logo_url")
  colorPrimary   String   @default("#FA1757") @map("color_primary")
  colorSecondary String   @default("#FC7914") @map("color_secondary")
  plan           String   @default("essai")
  isPublished    Boolean  @default(false) @map("is_published")

  // Champs attendus par le frontend client (marketplace, fiche boutique) —
  // absents du schéma d'origine, ajoutés à ta demande.
  city           String?
  country        String?
  description    String?
  rating         Float?   // pas de système d'avis pour l'instant : renseigné à la main (admin) ou laissé vide
  shippingFee    Decimal  @default(0) @map("shipping_fee") @db.Decimal(10, 2)

  // Coordonnées FedaPay pour recevoir les payouts (renseignées par le
  // marchand dans ses paramètres, ou saisies par l'admin si besoin).
  payoutPhone    String?  @map("payout_phone")
  payoutCountry  String?  @map("payout_country")

  // Abonnement boutique — voir src/lib/subscription.js pour toute la
  // logique. subscriptionExpiresAt est la SEULE source de vérité pour
  // savoir si la boutique est active ou suspendue (comparaison en temps
  // réel à chaque lecture, pas besoin de tâche cron pour "suspendre").
  subscriptionStatus    SubscriptionStatus @default(en_attente_paiement) @map("subscription_status")
  subscriptionExpiresAt DateTime?          @map("subscription_expires_at")
  creationFeePaid        Boolean           @default(false) @map("creation_fee_paid")

  // Modération admin : une boutique suspendue disparaît de la marketplace et
  // ne peut plus recevoir de commandes, quel que soit son abonnement. On ne
  // supprime jamais une boutique qui a un historique de transactions.
  isSuspended      Boolean   @default(false) @map("is_suspended")
  suspendedReason  String?   @map("suspended_reason")
  suspendedAt      DateTime? @map("suspended_at")

  createdAt      DateTime @default(now()) @map("created_at")
  products       Product[]
  storeOrders    StoreOrder[]
  subscriptionPayments SubscriptionPayment[]
  categories     Category[]
  @@map("stores")
}
model Category {
  id        Int        @id @default(autoincrement())
  name      String
  slug      String     @unique
  parentId  Int?       @map("parent_id")
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("SubCategories")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")

  // null = catégorie de la plateforme (gérée par Shopika, visible partout) ;
  // renseigné = catégorie créée par un marchand, utilisable seulement dans sa boutique.
  storeId   Int?       @map("store_id")
  store     Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("categories")
}

model Product {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id")
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  Int?      @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  promoPrice  Decimal?  @map("promo_price") @db.Decimal(10, 2)
  stock       Int       @default(0)
  weight      Float?
  images      String[]  @default([])
  videoUrl    String?   @map("video_url")
  // Couleurs proposées au client (thème « Catalogue ») :
  // [{ "name": "Rouge", "hex": "#C41E3A", "image": "https://..." }]
  // Validées par src/lib/storefront.js (sanitizeColors) avant écriture.
  colors      Json?
  isPublished Boolean   @default(false) @map("is_published")
  seoTitle    String?   @map("seo_title")
  seoDescription String? @map("seo_description")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  favorites   Favorite[]

  @@map("products")
}

enum OrderStatus {
  en_attente
  confirmee
  expediee
  livree
  terminee
  litige
  annulee
}

enum EscrowStatus {
  bloque
  libere
  rembourse
}

// Statut du PAIEMENT côté client (encaissement FedaPay), au niveau de la
// commande globale — distinct de l'escrow, qui gère la redistribution de
// l'argent une fois encaissé.
enum PaymentStatus {
  en_attente
  payee
  echouee
  remboursee
  // Commande jamais payée dans le délai imparti : annulée, stock remis en vente.
  annulee
}

// Statut du VERSEMENT au marchand (payout FedaPay), au niveau de chaque
// sous-commande — déclenché manuellement par l'admin depuis son espace.
enum PayoutStatus {
  en_attente
  en_cours
  effectue
  echoue
}

model Order {
  id              Int          @id @default(autoincrement())
  clientId        Int          @map("client_id")
  client          User         @relation(fields: [clientId], references: [id])
  totalAmount     Decimal      @db.Decimal(10, 2) @map("total_amount")
  deliveryAddress String       @map("delivery_address")
  deliveryCity    String?      @map("delivery_city")
  deliveryCountry String?      @map("delivery_country")
  // Numéro utilisé pour le paiement Mobile Money / la livraison — peut
  // différer du téléphone du compte (le compte client se connecte par e-mail).
  deliveryPhone   String?      @map("delivery_phone")

  paymentStatus        PaymentStatus @default(en_attente) @map("payment_status")
  paymentMethod         String?      @map("payment_method")   // "mobile_money" | "card"
  fedapayTransactionId  String?      @map("fedapay_transaction_id")
  paidAt                DateTime?    @map("paid_at")

  createdAt       DateTime     @default(now()) @map("created_at")
  storeOrders     StoreOrder[]

  @@index([paymentStatus, createdAt])
  @@map("orders")
}

model StoreOrder {
  id            Int          @id @default(autoincrement())
  orderId       Int          @map("order_id")
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId       Int          @map("store_id")
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Restrict)
  // subtotal = articles + frais de livraison de la boutique (figés à la commande).
  // C'est ce montant qui est versé au marchand ou remboursé au client.
  subtotal      Decimal      @db.Decimal(10, 2)
  shippingFee   Decimal      @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  status        OrderStatus  @default(en_attente)
  escrowStatus  EscrowStatus @default(bloque) @map("escrow_status")
  deliveryCode  String?      @map("delivery_code")
  // Échecs de saisie du code de livraison — verrouille la confirmation par
  // code après 5 essais (un code à 6 chiffres se devine sinon par force brute).
  deliveryCodeAttempts Int   @default(0) @map("delivery_code_attempts")
  confirmedAt   DateTime?    @map("confirmed_at")
  // Date d'expédition : sert à la confirmation automatique si le client ne répond pas.
  shippedAt     DateTime?    @map("shipped_at")

  // Versement au marchand — déclenché par l'admin une fois l'escrow libéré.
  payoutStatus    PayoutStatus @default(en_attente) @map("payout_status")
  fedapayPayoutId String?      @map("fedapay_payout_id")
  paidOutAt       DateTime?    @map("paid_out_at")

  // Remboursement du client — déclenché par l'admin après un litige tranché
  // en faveur du client (escrowStatus = rembourse).
  refundStatus     PayoutStatus @default(en_attente) @map("refund_status")
  fedapayRefundId  String?      @map("fedapay_refund_id")
  refundedAt       DateTime?    @map("refunded_at")

  createdAt     DateTime     @default(now()) @map("created_at")
  items         OrderItem[]

  @@map("store_orders")
}

model OrderItem {
  id           Int        @id @default(autoincrement())
  storeOrderId Int        @map("store_order_id")
  storeOrder   StoreOrder @relation(fields: [storeOrderId], references: [id], onDelete: Cascade)
  productId    Int        @map("product_id")
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Decimal    @db.Decimal(10, 2) @map("unit_price")
  // Couleur choisie par le client (nom d'une entrée de Product.colors), null si le produit n'en propose pas.
  variant      String?

  @@map("order_items")
}

// Notifications in-app (nouvelle commande, expédition, litige...).
// Le champ "link" permet au frontend de rediriger directement au clic.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "nouvelle_commande" | "commande_expediee" | "litige" | "payout_effectue" | "support_reponse"
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

enum SupportStatus {
  ouvert
  traite
}

// Suggestions / demandes envoyées par un marchand au support Shopika.
model SupportMessage {
  id          Int           @id @default(autoincrement())
  merchantId  Int           @map("merchant_id")
  merchant    User          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subject     String
  message     String
  status      SupportStatus @default(ouvert)
  adminReply  String?       @map("admin_reply")
  repliedAt   DateTime?     @map("replied_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("support_messages")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("favorites")
}


// Historique des paiements d'abonnement. La contrainte d'unicité sur
// fedapayTransactionId rend le webhook idempotent : FedaPay peut renvoyer
// le même événement, l'abonnement n'est prolongé qu'une seule fois.
model SubscriptionPayment {
  id                    Int      @id @default(autoincrement())
  storeId               Int      @map("store_id")
  store                 Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  fedapayTransactionId  String   @unique @map("fedapay_transaction_id")
  createdAt             DateTime @default(now()) @map("created_at")

  @@map("subscription_payments")
}

// Journal d'audit des actions sensibles de l'espace admin (versements,
// remboursements, arbitrages, modération). Append-only : aucune route ne
// modifie ni ne supprime ces lignes.
model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("admin_audit_logs")
}
