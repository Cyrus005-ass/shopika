{
  "buildCommand": "npm run vercel-build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron/expire-orders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/auto-confirm",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/subscription-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
