# ==== Base de données (inchangé) ====
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-x-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-x-eu-west-3.pooler.supabase.com:5432/postgres"

PORT=4000
JWT_SECRET=...

# Domaines autorisés à appeler l'API, séparés par des virgules (mets tes
# vraies URLs Vercel une fois déployé). Laisser vide = ouvert à tous
# (pratique en local, à éviter en production).
CORS_ORIGINS=

# ==== Supabase Storage (inchangé) ====
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=...

# ==== FedaPay ====
# Dashboard FedaPay > Paramètres > Clés API. Utilise les clés "sandbox"
# tant que tu testes, puis bascule sur les clés "live" + FEDAPAY_ENV=live
# le jour où tu es prêt à encaisser du vrai argent.
FEDAPAY_ENV=sandbox
FEDAPAY_PUBLIC_KEY=pk_sandbox_...
FEDAPAY_SECRET_KEY=sk_sandbox_...
# Dashboard FedaPay > Webhooks > (ton endpoint) > "Cliquer pour révéler".
# Différent entre sandbox et live, et par endpoint configuré.
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_...

# URL publique de SHOPIKA_clients, utilisée pour rediriger le client après
# son paiement FedaPay (ex: https://app.shopika.com — sans slash final).
CLIENT_APP_URL=http://localhost:5500

# URL publique de SHOPIKA_marchand, utilisée pour rediriger le marchand
# après un paiement d'abonnement (création boutique / réabonnement).
MERCHANT_APP_URL=http://localhost:5500

# Tarifs de l'abonnement boutique, en FCFA (voir src/lib/subscription.js).
STORE_CREATION_FEE=5000
STORE_MONTHLY_FEE=3000

# ==== E-mail (vérification de compte client) ====
# N'importe quel service SMTP fonctionne (Brevo, SendGrid, Mailjet, Amazon
# SES, ou même Gmail avec un "mot de passe d'application").
SMTP_HOST=smtp.exemple.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
SMTP_FROM="Shopika <no-reply@shopika.app>"

# Secret du cron Vercel (annulation des commandes non payées). Génère-le : openssl rand -hex 32
CRON_SECRET=
# Minutes avant qu'une commande non payée soit annulée (défaut 60)
ORDER_PAYMENT_TTL_MINUTES=60
# --- Exemples SMTP comment�s (d�commenter selon ton fournisseur) ---
# Gmail (port 465, mot de passe d'application requis) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tonemail@gmail.com
# SMTP_PASS=ton_mot_de_passe_d_application
# SMTP_FROM="Shopika <tonemail@gmail.com>"
#
# Brevo / Resend / autre (port 587 ou 465) :
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=ton_identifiant_smtp
# SMTP_PASS=ton_mot_de_passe_smtp
# SMTP_FROM="Shopika <no-reply@shopika.app>"

# CRON_SECRET : cha�ne al�atoire pour prot�ger /api/cron/expire-orders.
# G�n�re-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Puis renseigne-la dans les variables d'environnement Vercel.

# URL publique du front client (utilis�e pour le lien de v�rification dans les e-mails).
# Exemple : http://localhost:3000 en local, https://shopika-shopika-front.vercel.app en prod.
FRONT_URL=http://localhost:3000

# E-mail qui recoit les suggestions/questions envoyees depuis la page Support (client et marchand).
# Une ou plusieurs adresses separees par des virgules. Sans cette variable, l API ecrit aux comptes admin qui ont un e-mail.
SUPPORT_EMAIL=

# --- Ajouts de la refonte ---
# Confirmation automatique d'un colis expédié resté sans réponse du client (jours, défaut 7)
AUTO_CONFIRM_DAYS=7
# Durée de validité du lien « mot de passe oublié » (minutes, défaut 30)
PASSWORD_RESET_MINUTES=30
# URL publique du site client (liens e-mail, retour de paiement). CLIENT_APP_URL est accepté aussi.
# FRONT_URL=http://localhost:8080
